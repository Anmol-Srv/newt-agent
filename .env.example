# Copy to .env and fill in. Bun loads .env automatically.
OPENROUTER_API_KEY=

# Tracing (optional). Leave empty to disable. Cloud regions: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com, https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Postgres (compose.yaml starts one on 5436)
DATABASE_URL="postgres://newt:newt@localhost:5436/newt"
